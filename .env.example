# Copy this file to `.env` and fill in your own values.

# All model calls are routed through OpenRouter (https://openrouter.ai).
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Contact address sent in the User-Agent header of SEC EDGAR requests.
# The SEC requires a real address; requests without one may be throttled.
SEC_CONTACT_EMAIL=your-email@example.com
